#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D source_image;
layout(set = 0, binding = 1, rgba8) writeonly uniform image2D output_image;

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 output_extent = imageSize(output_image);

    if (pixel.x >= output_extent.x || pixel.y >= output_extent.y) {
        return;
    }

    const vec2 uv =
        (vec2(pixel) + vec2(0.5)) / vec2(output_extent);

    imageStore(
        output_image,
        pixel,
        textureLod(source_image, uv, 0.0));
}
