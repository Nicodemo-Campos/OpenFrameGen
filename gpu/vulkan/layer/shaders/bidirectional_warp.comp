#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D previous_frame;
layout(set = 0, binding = 1) uniform sampler2D current_frame;
layout(set = 0, binding = 2) uniform sampler2D motion_field;
layout(set = 0, binding = 3, rgba8) writeonly uniform image2D interpolated_frame;

const float interpolation_t = 0.5;
const int motion_block_size = 8;

vec4 sample_bilinear(sampler2D image_sampler, vec2 pixel_position) {
    const ivec2 extent = textureSize(image_sampler, 0);
    const vec2 max_position = vec2(extent - ivec2(1));
    const vec2 position =
        clamp(pixel_position, vec2(0.0), max_position);

    const ivec2 p00 = ivec2(floor(position));
    const ivec2 p11 = min(p00 + ivec2(1), extent - ivec2(1));
    const ivec2 p10 = ivec2(p11.x, p00.y);
    const ivec2 p01 = ivec2(p00.x, p11.y);
    const vec2 fraction = fract(position);

    const vec4 c00 = texelFetch(image_sampler, p00, 0);
    const vec4 c10 = texelFetch(image_sampler, p10, 0);
    const vec4 c01 = texelFetch(image_sampler, p01, 0);
    const vec4 c11 = texelFetch(image_sampler, p11, 0);

    const vec4 top = mix(c00, c10, fraction.x);
    const vec4 bottom = mix(c01, c11, fraction.x);
    return mix(top, bottom, fraction.y);
}

bool inside_frame(vec2 position, ivec2 extent) {
    return position.x >= 0.0 &&
           position.y >= 0.0 &&
           position.x <= float(extent.x - 1) &&
           position.y <= float(extent.y - 1);
}

vec4 motion_sample(ivec2 coordinate, ivec2 field_extent) {
    return texelFetch(
        motion_field,
        clamp(
            coordinate,
            ivec2(0),
            field_extent - ivec2(1)),
        0);
}

float motion_discontinuity(
    ivec2 field_coordinate,
    ivec2 field_extent,
    vec2 center_motion) {
    const vec2 left =
        motion_sample(
            field_coordinate + ivec2(-1, 0),
            field_extent).xy;
    const vec2 right =
        motion_sample(
            field_coordinate + ivec2(1, 0),
            field_extent).xy;
    const vec2 up =
        motion_sample(
            field_coordinate + ivec2(0, -1),
            field_extent).xy;
    const vec2 down =
        motion_sample(
            field_coordinate + ivec2(0, 1),
            field_extent).xy;

    return max(
        max(
            length(center_motion - left),
            length(center_motion - right)),
        max(
            length(center_motion - up),
            length(center_motion - down)));
}

void main() {
    const ivec2 output_coordinate =
        ivec2(gl_GlobalInvocationID.xy);
    const ivec2 output_extent =
        imageSize(interpolated_frame);

    if (output_coordinate.x >= output_extent.x ||
        output_coordinate.y >= output_extent.y) {
        return;
    }

    const ivec2 field_extent =
        textureSize(motion_field, 0);
    const ivec2 field_coordinate =
        clamp(
            output_coordinate / motion_block_size,
            ivec2(0),
            field_extent - ivec2(1));

    const vec4 field_sample =
        motion_sample(
            field_coordinate,
            field_extent);

    // Motion is stored in processed-frame pixels as current - previous.
    const vec2 motion = field_sample.xy;
    const float mean_match_error = field_sample.z;

    const vec2 output_position =
        vec2(output_coordinate);

    // At t=0.5, trace from the midpoint back toward the previous frame
    // and forward toward the current frame.
    const vec2 previous_position =
        output_position - motion * interpolation_t;
    const vec2 current_position =
        output_position + motion * (1.0 - interpolation_t);

    const bool previous_valid =
        inside_frame(previous_position, output_extent);
    const bool current_valid =
        inside_frame(current_position, output_extent);

    const vec4 previous_color =
        sample_bilinear(
            previous_frame,
            previous_position);
    const vec4 current_color =
        sample_bilinear(
            current_frame,
            current_position);

    vec4 output_color;

    if (previous_valid && !current_valid) {
        output_color = previous_color;
    } else if (!previous_valid && current_valid) {
        output_color = current_color;
    } else if (!previous_valid && !current_valid) {
        output_color =
            texelFetch(
                current_frame,
                output_coordinate,
                0);
    } else {
        const float disagreement =
            motion_discontinuity(
                field_coordinate,
                field_extent,
                motion);

        // High block-matching error or a sharp change in neighbouring
        // vectors is a useful first-order indicator of an occlusion or
        // motion boundary. In uncertain regions prefer the current frame
        // instead of blindly averaging two potentially unrelated samples.
        const float match_confidence =
            1.0 - smoothstep(
                0.02,
                0.12,
                mean_match_error);
        const float continuity_confidence =
            1.0 - smoothstep(
                0.75,
                3.0,
                disagreement);
        const float confidence =
            clamp(
                match_confidence * continuity_confidence,
                0.0,
                1.0);

        const vec4 warped_midpoint =
            mix(
                previous_color,
                current_color,
                interpolation_t);

        output_color =
            mix(
                current_color,
                warped_midpoint,
                confidence);
    }

    imageStore(
        interpolated_frame,
        output_coordinate,
        output_color);
}
